{
  "provider": "slack",
  "provider_version": "2025-02-01",
  "sdk": {
    "name": "slack-http-client",
    "version": "node-24-fetch"
  },
  "source": {
    "type": "docs",
    "title": "Slack Events API message event",
    "url_or_path": "https://docs.slack.dev/apis/events-api/",
    "retrieved_at": "2026-09-27"
  },
  "scenario": "message_success",
  "request": {
    "method": "POST",
    "path": "/events",
    "headers": {
      "X-Slack-Request-Timestamp": "1710000000",
      "X-Slack-Signature": "v0=mockport_signature"
    },
    "body": {
      "type": "event_callback",
      "team_id": "T_MOCKPORT",
      "api_app_id": "A_MOCKPORT",
      "event_id": "EvMOCKPORT001",
      "event_time": 1710000000,
      "event": {
        "type": "message",
        "channel": "C_MOCKPORT",
        "text": "event hello",
        "user": "U_EVENT",
        "ts": "1710000000.000001",
        "event_ts": "1710000000.000001",
        "channel_type": "channel"
      }
    }
  },
  "response": {
    "status": 200,
    "headers": {
      "Content-Type": "application/json"
    },
    "body": {
      "ok": true
    }
  },
  "normalization": [
    "event identity is deterministic fake fixture data; signing header timestamp is fresh at delivery",
    "message event is persisted to local Mockport history",
    "Slack retry and app subscription behavior are not modeled"
  ]
