{
  "provider": "line",
  "provider_version": "Messaging API v2",
  "sdk": { "name": "@line/bot-sdk", "version": "11.0.0" },
  "source": {
    "type": "sdk",
    "title": "LINE Messaging API reply message",
    "url_or_path": "https://developers.line.biz/en/reference/messaging-api/#send-reply-message",
    "retrieved_at": "2026-07-19"
  },
  "scenario": "line_success",
  "request": {
    "method": "POST",
    "path": "/v2/bot/message/reply",
    "headers": {
      "Authorization": "Bearer mockport_line_token",
      "Content-Type": "application/json"
    },
    "body": {
      "replyToken": "mockport_reply_token",
      "messages": [{ "type": "text", "text": "reply from LINE SDK" }]
    }
  },
  "response": {
    "status": 200,
    "headers": { "Content-Type": "application/json" },
    "body": {}
  },
  "normalization": [
    "channel and reply tokens use the mockport_ fake namespace",
    "response is reduced to the documented empty success object"
  ]
}
